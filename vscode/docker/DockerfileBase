# =============================================================================
# DockerfileBase - built ONCE per bug investigation.
#
#   docker build -f vscode/docker/DockerfileBase \
#     --build-arg BASE_COMMIT=<good-endpoint-sha> \
#     -t vscode:base vscode/docker
#
# Contains the environment AND the VS Code clone with dependencies already
# installed at BASE_COMMIT.
#
# Putting the dependency install here is the one deliberate departure from
# RippleGUItester. Ripple's DockerfileDiff clones and installs from scratch
# because it builds exactly two commits per pull request - nothing to amortise.
# A bisect builds ten or more commits from a narrow range where the lockfile
# barely moves, so the install belongs in the layer that is built once.
# DockerfileVersion then only reconciles the delta.
#
# BASE_COMMIT should be the GOOD endpoint of the bisect range: it is the
# closest thing to the whole range, so the dependency delta at every step is
# as small as possible.
# =============================================================================

FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive

# Ubuntu 22.04 on purpose: Python 3.10 still ships distutils, which the node-gyp
# versions pinned by older VS Code commits import. Bisect walks backwards
# through history, so the older interpreter is the safer end to start from.

RUN apt-get update && apt-get install -y --no-install-recommends locales \
 && locale-gen en_US.UTF-8 \
 && rm -rf /var/lib/apt/lists/*
ENV LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8

# --- 1. Build toolchain -------------------------------------------------------
# VS Code compiles native addons from source on Linux: native-keymap, kerberos,
# node-pty, spdlog, policy-watcher, and keytar on commits older than ~1.84.
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential pkg-config \
      git curl ca-certificates \
      python3 python-is-python3 python3-setuptools \
      libx11-dev libx11-xcb-dev libxkbfile-dev \
      libkrb5-dev \
      libsecret-1-dev \
 && rm -rf /var/lib/apt/lists/*

# --- 2. Electron runtime libraries --------------------------------------------
# From VS Code's own build/linux/debian/dep-lists.ts, minus what Ubuntu pulls in
# transitively. Fonts are added because a bare Ubuntu image has none and VS Code
# would otherwise render every glyph as a blank box - useless for GUI bug work.
RUN apt-get update && apt-get install -y --no-install-recommends \
      libgtk-3-0 libnss3 \
      libatk1.0-0 libatk-bridge2.0-0 libatspi2.0-0 \
      libcups2 libgbm1 libdrm2 libxshmfence1 \
      libxcomposite1 libxdamage1 libxrandr2 libxfixes3 libxext6 libxss1 \
      libxkbcommon0 libxkbfile1 \
      libpango-1.0-0 libcairo2 libasound2 \
      libcurl4 xdg-utils \
      fonts-liberation fontconfig \
 && rm -rf /var/lib/apt/lists/*

# --- 3. Virtual display and remote viewing ------------------------------------
# Electron needs an X display and a container has none. Xvfb is VS Code's own
# answer (build/azure-pipelines/linux/xvfb.init). fluxbox is required, not
# optional: without a window manager an Electron window cannot be moved, resized
# or focused. Ports and password match VS Code's own .devcontainer, so its
# README applies verbatim.
RUN apt-get update && apt-get install -y --no-install-recommends \
      xvfb fluxbox x11vnc novnc websockify \
      x11-utils procps \
 && rm -rf /var/lib/apt/lists/*

# --- 4. nvm, with no Node.js version pinned -----------------------------------
# .nvmrc has moved 4 -> 8 -> 10 -> 12 -> 16 -> 18 -> 20 -> 22 -> 24 across VS
# Code's history, so the version is read from the checked-out tree, never baked
# into the image.
ENV NVM_DIR=/usr/local/nvm
RUN mkdir -p "$NVM_DIR" \
 && curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.3/install.sh | bash \
 && printf '%s\n' \
      'export NVM_DIR=/usr/local/nvm' \
      '[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"' \
      > /etc/profile.d/nvm.sh

# `npm run compile` compiles all of src/ in one Node process. Node derives its
# heap from visible memory and self-caps near 2 GB in a container, dying with
# "Reached heap limit" (exit 134). 8192 is VS Code's own figure for its heavy
# Node build steps. Requires Docker Desktop memory >= 10 GB.
ENV NODE_OPTIONS=--max-old-space-size=8192

# Chromium's setuid sandbox cannot work in an unprivileged container. VS Code CI
# relaxes the host kernel instead (pr-linux-test.yml); in Docker the equivalent
# is to disable the sandbox.
ENV ELECTRON_DISABLE_SANDBOX=1
ENV DISPLAY=:99

# 0755 explicitly, not `chmod +x`: COPY preserves the source file's mode, and if
# the checkout is mode 0700 then `chmod +x` (which honours umask) leaves these
# unreadable to vscodedev and every launch fails.
COPY entrypoint.sh launch.sh /usr/local/bin/
RUN chmod 0755 /usr/local/bin/entrypoint.sh /usr/local/bin/launch.sh

# npm refuses some lifecycle scripts as root and Chromium's zygote is happier
# unprivileged.
RUN useradd -ms /bin/bash vscodedev \
 && chown -R vscodedev:vscodedev "$NVM_DIR"
USER vscodedev
WORKDIR /home/vscodedev

# ~/.cache must exist and be owned by vscodedev before any npm step: postinstall
# scripts write there (@playwright/browser-chromium -> ~/.cache/ms-playwright)
# and fail with EACCES if the directory is created by root first.
RUN mkdir -p /home/vscodedev/.cache /home/vscodedev/.npm

# VNC password, matching VS Code's .devcontainer.
RUN x11vnc -storepasswd vscode /home/vscodedev/.vncpass

# Login shell from here on, so /etc/profile.d/nvm.sh is sourced in every RUN.
SHELL ["/bin/bash", "-lc"]

# --- 5. The clone and the dependency install ----------------------------------
ARG BASE_COMMIT
ENV VSCODE_DIR=/home/vscodedev/vscode

# --filter=blob:none keeps the full commit graph while downloading file contents
# only for commits actually checked out. Materially smaller image than a full
# clone, which matters on a machine with under 50 GB free.
RUN test -n "$BASE_COMMIT" || { echo "ERROR: --build-arg BASE_COMMIT=<sha> is required"; exit 1; } \
 && git clone --filter=blob:none https://github.com/microsoft/vscode.git "$VSCODE_DIR" \
 && cd "$VSCODE_DIR" \
 && git checkout -q --detach "$BASE_COMMIT" \
 && echo "Base commit: $(git rev-parse HEAD)"

WORKDIR ${VSCODE_DIR}

# Node version this commit asks for; commits predating .nvmrc fall back to 20.
RUN NODE_VERSION="$(tr -d '[:space:]' < .nvmrc 2>/dev/null || true)" \
 && NODE_VERSION="${NODE_VERSION:-20}" \
 && echo "Base commit requires Node ${NODE_VERSION}" \
 && nvm install "${NODE_VERSION}" \
 && nvm alias default "${NODE_VERSION}"

# Dependencies. microsoft/vscode switched from yarn to npm in b5a6aa14a8c5
# (Sept 2024), which deleted yarn.lock and added package-lock.json in the same
# change; detecting the lockfile covers the whole history with no version table.
#
# The lockfile hash is recorded so DockerfileVersion can tell whether a commit
# needs a full reinstall or only a delta.
RUN if [ -f package-lock.json ]; then \
      npm ci; \
      sha1sum package-lock.json | cut -d' ' -f1 > /home/vscodedev/.lockhash; \
    elif [ -f yarn.lock ]; then \
      npm install -g yarn && yarn install --frozen-lockfile; \
      sha1sum yarn.lock | cut -d' ' -f1 > /home/vscodedev/.lockhash; \
    else \
      npm install; \
      echo none > /home/vscodedev/.lockhash; \
    fi

# Electron binary into .build/, mirroring .devcontainer/post-create.sh. Guarded
# because very old commits predate the script.
RUN if node -e "process.exit(require('./package.json').scripts.electron ? 0 : 1)"; then \
      npm run electron; \
    else \
      echo "No 'electron' script at this commit"; \
    fi

LABEL vscode.base.commit="${BASE_COMMIT}"
EXPOSE 5901 6080
CMD ["/usr/local/bin/entrypoint.sh"]
