# =============================================================================
# DockerfileBase - reusable environment for building and running historical
#                  Microsoft VS Code commits during bug localisation.
# =============================================================================
#
# Build once; reuse for every VSCODE_COMMIT. Contains no VS Code source and no
# pinned Node.js version, because both change from commit to commit.
#
# Evidence keys used below:
#   [DEPS]  microsoft/vscode build/linux/debian/dep-lists.ts -
#           `referenceGeneratedDepsByArch` + `additionalDeps`. This is VS Code's
#           own declared RUNTIME dependency list, the one baked into the .deb it
#           ships. It is the strongest available evidence for "what does the
#           VS Code GUI need in order to start".
#   [CI-b]  .github/workflows/pr.yml, pr-node-modules.yml, sessions-e2e.yml and
#           build/azure-pipelines/dependencies-check.yml, which all install:
#             build-essential pkg-config libx11-dev libx11-xcb-dev
#             libxkbfile-dev libnotify-bin libkrb5-dev
#           This is VS Code's own BUILD dependency list.
#   [CI-t]  .github/workflows/pr-linux-test.yml, copilot-setup-steps.yml:
#             pkg-config xvfb libgtk-3-0 libxkbfile-dev libkrb5-dev libgbm1
#             rpm bubblewrap socat
#   [CI-g]  .github/workflows/chat-perf.yml - the workflow that actually
#           launches Electron headlessly; adds libdrm2, libxshmfence1.
#   [REPO]  repository contents: package.json at specific tags, .nvmrc history,
#           build/azure-pipelines/linux/xvfb.init
#   [ASSUM] this project's own assumption / judgement call, NOT evidence.
#
# Ubuntu 22.04 (jammy) is chosen deliberately:
#   * Python 3.10, which still ships distutils. Ubuntu 24.04 has Python 3.12,
#     where distutils was removed; the older node-gyp versions pinned by
#     historical VS Code commits import it. Bug localisation walks backwards
#     through history, so the older interpreter is the safer choice. [ASSUM]
#   * Pre-t64 library names (libasound2, libcups2), matching the ABI era of the
#     Electron builds used by the VS Code versions in scope. [ASSUM]
# =============================================================================

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# UTF-8 locale. VS Code's build emits non-ASCII (NLS strings, gulp output) and
# is not reliable under the default POSIX locale. [ASSUM]
RUN apt-get update && apt-get install -y --no-install-recommends locales \
 && locale-gen en_US.UTF-8 \
 && update-locale LANG=en_US.UTF-8 \
 && rm -rf /var/lib/apt/lists/*
ENV LANG=en_US.UTF-8 LANGUAGE=en_US:en LC_ALL=en_US.UTF-8

# -----------------------------------------------------------------------------
# 1. Build toolchain
#
# VS Code compiles native addons from source on Linux: native-keymap, kerberos,
# node-pty, @vscode/spdlog, @vscode/policy-watcher, @parcel/watcher and - on
# commits older than ~1.84 - keytar. Every package here serves one of those.
# -----------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    # gcc / g++ / make, used by node-gyp for every native addon        [CI-b]
    build-essential \
    # node-gyp resolves native library flags through it                [CI-b]
    pkg-config \
    # node-gyp's generator is a Python script. python-is-python3 because
    # node-gyp on older commits invokes a bare `python`.               [ASSUM]
    python3 python-is-python3 \
    # node-gyp >= 10 imports setuptools where older versions used
    # distutils; installing both keeps either path working.            [ASSUM]
    python3-setuptools \
    # clone VS Code and check out the requested commit                 [REPO]
    git \
    # fetch the Node.js tarball in DockerfileVersion
    curl ca-certificates \
    # headers for `native-keymap`                                      [CI-b]
    libx11-dev libx11-xcb-dev libxkbfile-dev \
    # headers for `kerberos`                                           [CI-b]
    libkrb5-dev \
    # headers for `keytar`. Verified present in package.json at tags
    # 1.50.0 / 1.60.0 / 1.70.0 / 1.75.0 / 1.80.0 and absent by 1.85.0,
    # so this is needed only for the older half of the history - which
    # is exactly where a bug-localisation bisect ends up.              [REPO]
    libsecret-1-dev \
 && rm -rf /var/lib/apt/lists/*
#
# Deliberately NOT installed, despite appearing in VS Code's own apt lists:
#   libnotify-bin        appears in [CI-b], but grepping the repository finds
#                        no reference to notify-send or libnotify in any build
#                        script or package.json. Unjustified here.
#   rpm, fakeroot        only needed to produce distributable .deb/.rpm
#                        packages (build/azure-pipelines). Bug reproduction
#                        runs the development build, not an installer.
#   bubblewrap, socat    [CI-t]/[DEPS] list them for agent command sandboxing;
#                        they are Recommends, not Depends, and are not needed
#                        to start the editor.
#   sqlite3, jq, unzip,
#   imagemagick, xdotool  Ripple installs these for its own tooling. Nothing in
#                        VS Code's build or launch path uses them.

# -----------------------------------------------------------------------------
# 2. Electron / Chromium runtime libraries
#
# This list is VS Code's own declared runtime dependency set from
# build/linux/debian/dep-lists.ts [DEPS]. Entries that arrive transitively on
# Ubuntu (libglib2.0-0, libexpat1, libdbus-1-3, libx11-6, libxcb1, libxext6,
# libudev1, libnspr4, libatspi2.0-0) are not repeated; they come in as Depends
# of the packages below even under --no-install-recommends.
# -----------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgtk-3-0 \
    libnss3 \
    libatk1.0-0 libatk-bridge2.0-0 libatspi2.0-0 \
    libcups2 \
    libgbm1 \
    libxcomposite1 libxdamage1 libxrandr2 libxfixes3 libxext6 \
    libxkbcommon0 libxkbfile1 \
    libpango-1.0-0 libcairo2 \
    libasound2 \
    # listed in [DEPS] additionalDeps for Breakpad crash reporting
    libcurl4 \
    # listed in [DEPS] additionalDeps for OS integration (xdg-open etc.)
    xdg-utils \
    # not in [DEPS]; in [CI-g], the workflow that actually launches Electron
    libdrm2 libxshmfence1 \
    # not in [DEPS]; in .github/workflows/monaco-editor.yml. Chromium's X
    # screensaver-inhibition path.                                     [REPO]
    libxss1 \
 && rm -rf /var/lib/apt/lists/*

# Fonts. Not in any VS Code list, because CI runners and real desktops already
# have fonts, but a bare Ubuntu image has none and VS Code then renders every
# glyph as a blank box - which makes GUI bug reproduction useless. [ASSUM]
RUN apt-get update && apt-get install -y --no-install-recommends \
    fonts-liberation fontconfig \
 && rm -rf /var/lib/apt/lists/*

# -----------------------------------------------------------------------------
# 3. Virtual display
#
# Xvfb is VS Code's own answer to "no display on Linux": the repository carries
# build/azure-pipelines/linux/xvfb.init and every GUI-touching workflow starts
# it before running Electron.                                   [REPO] [CI-t]
# x11vnc is added on top so a human can watch and drive the window while
# localising a GUI bug. That is this project's whole purpose, so it is
# justified on its own terms rather than borrowed from Ripple.        [ASSUM]
# No XFCE desktop: VS Code is the only window that needs to exist, and a full
# desktop session is the largest single thing Ripple installs.
# -----------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb x11vnc \
 && rm -rf /var/lib/apt/lists/*

# -----------------------------------------------------------------------------
# 4. nvm, with no Node.js version pinned
#
# .nvmrc in microsoft/vscode has moved 4 -> 8 -> 8.9.2 -> 10 -> 12 -> 16.14 ->
# 16.17 -> 18.15 -> 18.17 -> 18.17.1 -> 18.19.0 -> 20.x -> 22.x -> 24.x across
# the repository's history (verified with `git log -p -- .nvmrc`). Spot checks:
# 1.85.0 -> 18.17.1, 1.96.0 -> 20.18.0, 1.100.0 -> 20.19.0.
# Pinning one Node version in the base image would therefore be wrong for most
# historical commits. The base ships the version manager; DockerfileVersion
# installs whatever the checked-out commit asks for.                    [REPO]
# -----------------------------------------------------------------------------
ENV NVM_DIR=/usr/local/nvm
RUN mkdir -p "$NVM_DIR" \
 && curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.3/install.sh | bash \
 && printf '%s\n' \
      'export NVM_DIR=/usr/local/nvm' \
      '[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"' \
      > /etc/profile.d/nvm.sh

# -----------------------------------------------------------------------------
# V8 heap size for the build
#
# `npm run compile` compiles all of src/ in a single Node process. Node derives
# its default old-space heap from the memory it can see, so in a container it
# self-caps near 2 GB and the compile dies with
#   FATAL ERROR: Reached heap limit Allocation failed (exit 134)
# On a dev machine or a CI runner this never appears, which is why gulp does
# not set it.
#
# 8192 is VS Code's own figure: package.json runs its heavy Node build steps as
# `node --max-old-space-size=8192` (the `eslint` and
# `define-class-fields-check` scripts).                                  [REPO]
#
# Requires the Docker VM to actually have that much memory. On Docker Desktop:
# Settings > Resources > Memory >= 8 GB, or the build is OOM-killed (exit 137).
#
# The launch script in DockerfileVersion unsets this before starting Electron,
# mirroring resources/darwin/bin/code.sh, which also unsets NODE_OPTIONS
# before launching the app.                                              [REPO]
# -----------------------------------------------------------------------------
ENV NODE_OPTIONS=--max-old-space-size=8192

# Chromium's setuid/namespace sandbox cannot work in an unprivileged container.
# VS Code CI relaxes the host kernel instead
# (`sysctl -w kernel.apparmor_restrict_unprivileged_userns=0`, pr-linux-test.yml);
# inside Docker the equivalent is to disable the sandbox.              [CI-t]
ENV ELECTRON_DISABLE_SANDBOX=1
ENV DISPLAY=:99

# Non-root user: npm refuses to run some lifecycle scripts as root, and
# Chromium's zygote is happier unprivileged.                          [ASSUM]
RUN useradd -ms /bin/bash vscodedev \
 && chown -R vscodedev:vscodedev "$NVM_DIR"
USER vscodedev
WORKDIR /home/vscodedev

SHELL ["/bin/bash", "-lc"]
CMD ["bash", "-l"]
