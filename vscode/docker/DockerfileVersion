# =============================================================================
# DockerfileVersion - build one specific VS Code commit on top of the base
# =============================================================================
#
#   docker build -f DockerfileVersion \
#     --build-arg VSCODE_COMMIT=<sha> \
#     -t vscode-bugloc:<sha-short> .
#
# VSCODE_COMMIT is the only build argument. It is the commit that git bisect
# (or VS Code's own bisect) handed you.
#
# The source is cloned inside the build rather than copied from
# "vscode/source/vscode". That keeps the build context empty and the result
# reproducible from a SHA alone, which matters more here than clone time. The
# local clone next door is still the useful place to *run* git bisect and to
# read history; it just is not the build input.
# =============================================================================

FROM vscode-bugloc:base

ARG VSCODE_COMMIT

# Login shell so /etc/profile.d/nvm.sh is sourced in every RUN.
SHELL ["/bin/bash", "-lc"]

USER vscodedev
ENV VSCODE_DIR=/home/vscodedev/vscode
WORKDIR /home/vscodedev

# -----------------------------------------------------------------------------
# 1-3. Obtain the source and check out exactly VSCODE_COMMIT
#
# Fetching the single commit by SHA (GitHub allows this) avoids pulling the
# whole ~2 GB history. Falls back to a full clone if the SHA is not directly
# fetchable, e.g. a commit only reachable from a fork or an unadvertised ref.
# -----------------------------------------------------------------------------
RUN test -n "$VSCODE_COMMIT" || { echo "ERROR: --build-arg VSCODE_COMMIT=<sha> is required"; exit 1; } \
 && mkdir -p "$VSCODE_DIR" && cd "$VSCODE_DIR" \
 && git init -q . \
 && git remote add origin https://github.com/microsoft/vscode.git \
 && ( git fetch --depth 1 origin "$VSCODE_COMMIT" \
      || { echo "Shallow fetch by SHA failed, falling back to full clone"; \
           git fetch origin; } ) \
 && git checkout -q --detach "$VSCODE_COMMIT" \
 && echo "Checked out: $(git rev-parse HEAD)"

WORKDIR ${VSCODE_DIR}

# -----------------------------------------------------------------------------
# 4a. Node.js version required *by this commit*
#
# .nvmrc has moved 4 -> 8 -> 10 -> 12 -> 16 -> 18 -> 20 -> 22 -> 24 across VS
# Code's history, so the version is read from the checked-out tree rather than
# baked into the base image. Commits older than the introduction of .nvmrc
# (pre-2016) fall back to Node 16, the oldest version nvm can still fetch
# reliably.
# -----------------------------------------------------------------------------
RUN NODE_VERSION="$(cat .nvmrc 2>/dev/null | tr -d '[:space:]')" \
 && NODE_VERSION="${NODE_VERSION:-16}" \
 && echo "Commit requires Node.js ${NODE_VERSION}" \
 && nvm install "${NODE_VERSION}" \
 && nvm alias default "${NODE_VERSION}" \
 && node --version && npm --version

# -----------------------------------------------------------------------------
# 4b. Dependencies, using the package manager *this commit* expects
#
# microsoft/vscode switched from yarn to npm in commit b5a6aa14a8c5
# ("feat: switch to npm as default package manager", 2024-09-06), which
# deleted yarn.lock/.yarnrc and added package-lock.json in one change.
# Detecting the lockfile therefore covers the whole history with two branches
# and no version table.
#
# `npm run electron` afterwards mirrors .devcontainer/post-create.sh
# ("npm i && npm run electron") and guarantees the Electron binary is present
# in .build/electron even when the install lifecycle did not fetch it.
# -----------------------------------------------------------------------------
RUN if [ -f package-lock.json ]; then \
      echo "npm era (package-lock.json present)"; \
      npm ci; \
    elif [ -f yarn.lock ]; then \
      echo "yarn era (yarn.lock present)"; \
      npm install -g yarn; \
      yarn install --frozen-lockfile; \
    else \
      echo "No lockfile found; falling back to npm install"; \
      npm install; \
    fi

RUN npm run electron

# -----------------------------------------------------------------------------
# 5. Build
#
# `compile` produces the runnable development build that ./scripts/code.sh
# launches. This is deliberately not a packaged .deb/.rpm build: VS Code's
# release pipeline (build/azure-pipelines/linux/setup-env.sh) downloads
# Chromium sysroots and a pinned clang to produce distributable binaries, and
# none of that is needed to reproduce a bug.
# -----------------------------------------------------------------------------
RUN npm run compile

# -----------------------------------------------------------------------------
# 6. Launchable environment
#
# Starts Xvfb (VS Code's own choice of virtual display: see
# build/azure-pipelines/linux/xvfb.init in the repo) plus x11vnc so the window
# can be watched and driven on port 5900, then runs VS Code.
#
# --no-sandbox: Chromium's setuid/namespace sandbox does not work in an
# unprivileged container. VS Code CI relaxes the host kernel instead
# (kernel.apparmor_restrict_unprivileged_userns=0 in pr-linux-test.yml);
# disabling the sandbox is the container-side equivalent.
# --disable-gpu / SwiftShader: no GPU is exposed to the container.
# -----------------------------------------------------------------------------
RUN printf '%s\n' \
  '#!/bin/bash' \
  'set -e' \
  'source /etc/profile.d/nvm.sh' \
  'DISPLAY_NUM="${DISPLAY:-:99}"' \
  'Xvfb "$DISPLAY_NUM" -screen 0 1280x900x24 -ac >/tmp/xvfb.log 2>&1 &' \
  'sleep 2' \
  'x11vnc -display "$DISPLAY_NUM" -forever -nopw -shared -rfbport 5900 \' \
  '        -listen 0.0.0.0 >/tmp/x11vnc.log 2>&1 &' \
  'cd "$VSCODE_DIR"' \
  'exec ./scripts/code.sh --no-sandbox --disable-gpu \' \
  '     --disable-dev-shm-usage --user-data-dir /tmp/vscode-user-data "$@"' \
  > /home/vscodedev/launch-vscode.sh \
 && chmod +x /home/vscodedev/launch-vscode.sh

# Record which commit this image is, so an image found later is identifiable.
RUN echo "$VSCODE_COMMIT" > /home/vscodedev/VSCODE_COMMIT
LABEL vscode.commit="${VSCODE_COMMIT}"

EXPOSE 5900
WORKDIR ${VSCODE_DIR}
CMD ["/home/vscodedev/launch-vscode.sh"]
