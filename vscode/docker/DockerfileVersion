# =============================================================================
# DockerfileVersion - built ONCE PER COMMIT during a bisect.
#
#   docker build -f vscode/docker/DockerfileVersion \
#     --build-arg COMMIT=<sha> \
#     -t vscode:<short-sha> vscode/docker
#
# Normally driven by bisect-step.sh rather than run by hand.
#
# COMMIT is the only input - the single commit git bisect handed you.
#
# This image inherits the clone, node_modules and .build/ from vscode:base, so
# it does not clone and does not reinstall from scratch. That is what keeps a
# bisect step to minutes instead of tens of minutes, and what keeps each image
# to ~2 GB of new layers instead of another ~8 GB.
# =============================================================================

FROM vscode:base

ARG COMMIT

# Login shell so nvm is available in every RUN.
SHELL ["/bin/bash", "-lc"]
USER vscodedev
WORKDIR /home/vscodedev/vscode

# --- 1. Check out the commit under test ---------------------------------------
# The blobless clone in the base already carries the whole commit graph, so a
# fetch is normally unnecessary - only reach for the network if the SHA is
# genuinely unknown (a commit pushed since the base was built).
RUN test -n "$COMMIT" || { echo "ERROR: --build-arg COMMIT=<sha> is required"; exit 1; } \
 && if ! git cat-file -e "${COMMIT}^{commit}" 2>/dev/null; then \
      echo "Commit not in the base clone, fetching"; \
      git fetch -q origin "$COMMIT" 2>/dev/null || git fetch -q origin; \
    fi \
 && git checkout -q --detach "$COMMIT" \
 && echo "Testing commit: $(git rev-parse HEAD)"

# --- 2. Node version for THIS commit ------------------------------------------
# Usually identical to the base's, in which case nvm install is a no-op.
RUN NODE_VERSION="$(tr -d '[:space:]' < .nvmrc 2>/dev/null || true)" \
 && NODE_VERSION="${NODE_VERSION:-20}" \
 && nvm install "${NODE_VERSION}" \
 && nvm alias default "${NODE_VERSION}" \
 && echo "Node $(node --version)"

# --- 3. Dependencies: delta only, unless the lockfile actually moved ----------
# `npm install` is used, NOT `npm ci`: npm ci deletes node_modules before
# installing, which would throw away exactly what the base image provides. With
# an unchanged lockfile `npm install` reports "up to date" and costs seconds.
#
# If the lockfile HAS changed relative to the base, the delta may be large
# enough that a clean install is the safer choice, so fall back to npm ci.
RUN set -e; \
    if   [ -f package-lock.json ]; then LOCK=package-lock.json; \
    elif [ -f yarn.lock ];         then LOCK=yarn.lock; \
    else                                LOCK=""; fi; \
    if [ -n "$LOCK" ]; then NOW="$(sha1sum "$LOCK" | cut -d' ' -f1)"; else NOW=none; fi; \
    WAS="$(cat /home/vscodedev/.lockhash 2>/dev/null || echo unknown)"; \
    echo "lockfile: $LOCK  this=$NOW  base=$WAS"; \
    if [ "$NOW" = "$WAS" ]; then \
      echo "Lockfile matches the base image - reconciling only"; \
      npm install --no-audit --no-fund; \
    elif [ "$LOCK" = "package-lock.json" ]; then \
      echo "Lockfile differs from the base image - clean install"; \
      npm ci; \
    elif [ "$LOCK" = "yarn.lock" ]; then \
      echo "Lockfile differs from the base image - clean yarn install"; \
      npm install -g yarn; \
      yarn install --frozen-lockfile; \
    else \
      npm install --no-audit --no-fund; \
    fi

# Keep the Electron binary in sync with this commit's pinned version. Cheap when
# it already matches.
RUN if node -e "process.exit(require('./package.json').scripts.electron ? 0 : 1)"; then \
      npm run electron; \
    fi

# --- 4. Compile ---------------------------------------------------------------
# out/ is wiped first: `git checkout` does not remove compiled output belonging
# to source files that no longer exist at this commit, and a stale file there
# could change how the editor behaves - which would corrupt a bisect verdict.
# node_modules and .build/ are kept; they are the expensive parts.
#
# `compile` produces the runnable development build that ./scripts/code.sh
# launches. Deliberately not a packaged .deb: the release pipeline downloads
# Chromium sysroots and a pinned clang, none of which is needed to reproduce a
# bug.
RUN rm -rf out out-build \
 && npm run compile

# Record which commit this image is, so one found later is identifiable.
RUN echo "$COMMIT" > /home/vscodedev/COMMIT
LABEL vscode.commit="${COMMIT}"

EXPOSE 5901 6080
CMD ["/usr/local/bin/entrypoint.sh"]
